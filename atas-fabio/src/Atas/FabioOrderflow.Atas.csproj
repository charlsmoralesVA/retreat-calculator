<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Builds the ATAS indicator + strategy against the DLLs of YOUR ATAS installation.

      dotnet build src/Atas/FabioOrderflow.Atas.csproj -c Release -p:AtasDir="C:\Program Files (x86)\ATAS Platform"

    Check your ATAS version's target framework and pass it if it is not .NET 8:
      -p:AtasTarget=net48            (older ATAS builds run on .NET Framework 4.8)
      -p:AtasTarget=net8.0-windows   (default; add -p:AtasUseWpf=true if the ATAS assemblies need WPF types)
    Optional: -p:DefineConstants=NO_PANEL  drops the on-chart panel if OnRender does not match your ATAS version.

    Output: FabioOrderflow.Atas.dll + FabioOrderflow.Core.dll. Copy BOTH into ATAS's custom indicators/strategies folder.
  -->
  <PropertyGroup>
    <AtasTarget Condition="'$(AtasTarget)' == ''">net8.0-windows</AtasTarget>
    <TargetFramework>$(AtasTarget)</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>FabioOrderflow.Atas</RootNamespace>
    <AssemblyName>FabioOrderflow.Atas</AssemblyName>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF Condition="'$(AtasUseWpf)' == 'true'">true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\FabioOrderflow.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AtasDlls Include="$(AtasDir)/ATAS.*.dll;$(AtasDir)/OFT.*.dll" />
    <AtasDlls Include="$(AtasDir)/Utils.Common.dll" Condition="Exists('$(AtasDir)/Utils.Common.dll')" />
    <Reference Include="@(AtasDlls)">
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="RequireAtasDir" BeforeTargets="ResolveAssemblyReferences;CoreCompile">
    <Error Condition="'$(AtasDir)' == ''" Text="Set the ATAS install folder: dotnet build -p:AtasDir=&quot;C:\Program Files (x86)\ATAS Platform&quot;" />
    <Error Condition="'@(AtasDlls)' == ''" Text="No ATAS.*.dll found in AtasDir='$(AtasDir)'. Point AtasDir at the folder that contains ATAS.Indicators.dll." />
  </Target>

</Project>
