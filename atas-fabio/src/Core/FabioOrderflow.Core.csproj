<Project Sdk="Microsoft.NET.Sdk">

  <!-- ATAS-independent logic. netstandard2.0 loads in both .NET Framework and modern .NET hosts. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>FabioOrderflow.Core</RootNamespace>
    <AssemblyName>FabioOrderflow.Core</AssemblyName>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
